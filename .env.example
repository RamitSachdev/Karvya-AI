# Copy to .env.local for local use, and add the same values in Vercel > Settings > Environment Variables.

# Where leads are stored. Without these the deployed API refuses submissions (503) rather than lose them.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Long random string that protects /api/admin/*. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Long random string that signs agent access links. Changing it breaks links already sent.
# Generate with: openssl rand -hex 32
AGENT_LINK_SECRET=

# From https://platform.claude.com. This is what the agents run on, and it costs money per use.
ANTHROPIC_API_KEY=

# Your live address, used to build access links. Example: https://karvya.ai
PUBLIC_SITE_URL=

# Optional for now. Receives a POST when you approve a lead, including the access link,
# and sends the trial email. Until then, copy the link from /admin and email it yourself.
TRIAL_WEBHOOK_URL=

# Optional tuning. These are the defaults.
# AGENT_MODEL=claude-opus-5-5
# AGENT_EFFORT=medium
# TRIAL_DAYS=14
# TRIAL_BUDGET_UNITS=250000
# AGENT_MAX_TOKENS=8000
# Stops all agents once this much has been spent, across every company.
# SPEND_LIMIT_USD=4
